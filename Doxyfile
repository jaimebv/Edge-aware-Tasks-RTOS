# Doxygen configuration for Edge-aware Tasks RTOS

PROJECT_NAME           = "Edge-aware Tasks RTOS"
PROJECT_BRIEF          = "ESP32 / ESP-IDF task-pair framework with monitoring and RTOS abstractions"
OUTPUT_DIRECTORY       = docs/doxygen
CREATE_SUBDIRS         = YES

INPUT                  = README.md \
                         CONTRIBUTING.md \
                         docs \
                         src \
                         components/EEAA/include \
                         components/EEAA/src \
                         components/EEAA/examples
FILE_PATTERNS          = *.h \
                         *.c \
                         *.md
RECURSIVE              = YES
EXCLUDE                = .pio \
                         docs/doxygen
EXCLUDE_PATTERNS       = */build/*

USE_MDFILE_AS_MAINPAGE  = docs/index.md
MARKDOWN_SUPPORT        = YES
AUTOLINK_SUPPORT        = YES

GENERATE_HTML          = YES
HTML_OUTPUT            = html
GENERATE_LATEX         = NO
GENERATE_XML           = NO
GENERATE_MAN           = NO
GENERATE_RTF           = NO

SOURCE_BROWSER         = YES
INLINE_SOURCES         = NO
REFERENCED_BY_RELATION  = YES
REFERENCES_RELATION     = YES
VERBATIM_HEADERS       = YES
STRIP_CODE_COMMENTS    = NO

EXTRACT_ALL            = NO
EXTRACT_PRIVATE        = NO
EXTRACT_STATIC         = NO
EXTRACT_LOCAL_CLASSES  = NO
EXTRACT_LOCAL_METHODS  = NO

WARN_IF_UNDOCUMENTED   = YES
WARN_IF_DOC_ERROR      = YES
WARN_AS_ERROR          = NO
QUIET                  = NO
INPUT_ENCODING         = UTF-8

GENERATE_TREEVIEW      = YES
SEARCHENGINE           = YES
FULL_PATH_NAMES        = NO
STRIP_FROM_PATH        = .

ALPHABETICAL_INDEX     = YES
COLS_IN_ALPHA_INDEX    = 3

OPTIMIZE_OUTPUT_FOR_C  = YES
OPTIMIZE_OUTPUT_VHDL   = NO

HAVE_DOT               = NO
